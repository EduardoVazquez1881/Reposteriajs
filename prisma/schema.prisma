// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pastel {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String
  precio      Float
  imagen      String
  destacado   Boolean  @default(false)
  etiquetas   String[]
  calificacion Float   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pedidos     PedidoItem[]
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  direccion String?
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pedidos   Pedido[]
}

model Pedido {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  estado        String   @default("pendiente") // pendiente, confirmado, enviado, entregado
  total         Float
  direccionEnvio String
  instrucciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         PedidoItem[]
}

model PedidoItem {
  id        Int      @id @default(autoincrement())
  pedidoId  Int
  pedido    Pedido   @relation(fields: [pedidoId], references: [id])
  pastelId  Int
  pastel    Pastel   @relation(fields: [pastelId], references: [id])
  cantidad  Int
  precio    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modelo para productos (pasteles y materias primas)
model Producto {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  tipo        String   // "pastel" o "materia_prima"
  precio      Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  unidad      String   // "kg", "ml", "unidad"
  imagen      String?
  destacado   Boolean  @default(false)
  disponible  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  ingredientes Ingrediente[]
  pedidos      PedidoProducto[]
  recetas      RecetaProducto[]
}

// Modelo para ingredientes (materias primas)
model Ingrediente {
  id          String   @id @default(uuid())
  nombre      String
  cantidad    Decimal  @db.Decimal(10, 2)
  unidad      String   // "kg", "ml", "unidad"
  stockMinimo Decimal  @db.Decimal(10, 2)
  stockMaximo Decimal  @db.Decimal(10, 2)
  proveedor   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  productos   Producto[]
  recetas     RecetaIngrediente[]
}

// Modelo para recetas
model Receta {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  instrucciones String @db.Text
  tiempoPreparacion Int // en minutos
  dificultad  String   // "facil", "medio", "dificil"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  productos   RecetaProducto[]
  ingredientes RecetaIngrediente[]
}

// Modelo para pedidos personalizados
model PedidoPersonalizado {
  id          String   @id @default(uuid())
  clienteId   String
  descripcion String
  fechaEntrega DateTime
  estado      String   // "pendiente", "en_proceso", "completado", "cancelado"
  precio      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  productos   PedidoProducto[]
  cliente     User     @relation(fields: [clienteId], references: [id])
}

// Tablas de relación
model RecetaProducto {
  id          String   @id @default(uuid())
  recetaId    String
  productoId  String
  cantidad    Decimal  @db.Decimal(10, 2)
  unidad      String

  // Relaciones
  receta      Receta   @relation(fields: [recetaId], references: [id])
  producto    Producto @relation(fields: [productoId], references: [id])
}

model RecetaIngrediente {
  id          String   @id @default(uuid())
  recetaId    String
  ingredienteId String
  cantidad    Decimal  @db.Decimal(10, 2)
  unidad      String

  // Relaciones
  receta      Receta     @relation(fields: [recetaId], references: [id])
  ingrediente Ingrediente @relation(fields: [ingredienteId], references: [id])
}

model PedidoProducto {
  id          String   @id @default(uuid())
  pedidoId    String
  productoId  String
  cantidad    Int
  precio      Decimal  @db.Decimal(10, 2)

  // Relaciones
  pedido      PedidoPersonalizado @relation(fields: [pedidoId], references: [id])
  producto    Producto            @relation(fields: [productoId], references: [id])
}
